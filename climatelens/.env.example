# LLM provider - using Groq (free, open-source Llama model) instead of OpenAI
GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY is no longer required - embeddings now run locally via HuggingFace

# MongoDB (chat history, raw documents, session metadata)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=climatelens

# SQLite (structured analytics - query stats, alignment scores)
SQLITE_PATH=./data/analytics.db

# Chroma vector store persistence path
CHROMA_PERSIST_DIR=./data/chroma_store

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
